# =============================================================================
# Aether Prototype - Environment Configuration Template
# =============================================================================
# Note: The application runs completely in-memory in mock/simulation mode.
# All variables below are OPTIONAL and only used when integrating with external
# endpoints or telemetry services. Do NOT commit production secrets here.
# =============================================================================

# Application Environment (e.g. development, staging, production)
VITE_APP_ENV=development

# Optional Backend Endpoint for Enterprise Solution / Contact Form Submissions
# If unset, form submissions simulate successful delivery locally in the UI.
VITE_CONTACT_API_URL=

# Optional Analytics / Telemetry Key (e.g. Google Analytics / Plausible)
# If unset, telemetry tracking is disabled.
VITE_ANALYTICS_KEY=
